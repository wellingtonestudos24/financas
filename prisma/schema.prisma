generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  creditCards  CreditCard[]
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
  OTHER
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType   @default(CHECKING)
  color          String        @default("#0f766e")
  // Valores monetários em centavos para evitar erro de ponto flutuante.
  initialBalance Int           @default(0)
  createdAt      DateTime      @default(now())
  transactions   Transaction[] @relation("AccountTransactions")
  transfersIn    Transaction[] @relation("TransferDestination")
  creditCards    CreditCard[]

  @@index([userId])
}

model CreditCard {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  color            String        @default("#7c3aed")
  limit            Int
  // Dias limitados a 1-28 para existirem em todos os meses.
  closingDay       Int
  dueDay           Int
  // Conta sugerida para pagar as faturas.
  paymentAccountId String?
  paymentAccount   Account?      @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  transactions     Transaction[]

  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  // Pagamento de fatura: sai da conta, mas não conta como despesa (as compras já contaram).
  CARD_PAYMENT
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         TransactionType
  color        String          @default("#64748b")
  transactions Transaction[]

  @@unique([userId, name, type])
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TransactionType
  description  String
  amount       Int
  date         DateTime        @db.Date
  paid         Boolean         @default(true)
  // Vazio nas compras no cartão; preenchido em todo o resto.
  accountId    String?
  account      Account?        @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  // Compras no cartão (EXPENSE) e pagamentos de fatura (CARD_PAYMENT).
  creditCardId String?
  creditCard   CreditCard?     @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  // Primeiro dia do mês em que a fatura fecha; fixado na criação.
  invoiceMonth DateTime?       @db.Date
  // Só para transferências: conta que recebe o valor.
  toAccountId  String?
  toAccount    Account?        @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([userId, date])
  @@index([creditCardId, invoiceMonth])
}
